{
    "framework": null,
    "cleanUrls": true,
    "functions": {
        "api/*.py": {
            "maxDuration": 60,
            "excludeFiles": "{resources,public,playground,articles,projects,pacey,dist,src,styles,.archive,node_modules,.venv,venv,.vercel,.vercel.bak,tests}/**"
        }
    },
    "redirects": [
        {
            "source": "/projects/pacey",
            "destination": "/pacey",
            "permanent": true
        },
        {
            "source": "/projects/pacey/",
            "destination": "/pacey",
            "permanent": true
        },
        {
            "source": "/pacey/landing",
            "destination": "/pacey",
            "permanent": true
        },
        {
            "source": "/pacey/landing.html",
            "destination": "/pacey",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/biwa-pair",
            "destination": "/api/biwa-trip/pair"
        },
        {
            "source": "/projects/biwa-ride/api/biwa-pair",
            "destination": "/api/biwa-trip/pair"
        },
        {
            "source": "/projects/running-posture-analyser/analyse",
            "destination": "/api/analyse"
        },
        {
            "source": "/projects/biwa-ride/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/pacey/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/pacey/demo",
            "destination": "/pacey/app.html"
        },
        {
            "source": "/pacey/demo/",
            "destination": "/pacey/app.html"
        },
        {
            "source": "/pacey/app",
            "destination": "/pacey/app.html"
        },
        {
            "source": "/pacey/app/",
            "destination": "/pacey/app.html"
        },
        {
            "source": "/projects/pacey/api/(.*)",
            "destination": "/api/$1"
        }
    ]
}
