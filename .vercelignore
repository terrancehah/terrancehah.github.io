# Python virtual environment
venv/
env/
ENV/
.venv

# Archive directory
.archive/

# Node modules (Vercel handles this, but being explicit)
node_modules/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Development files
.env.local
*.log

# Secrets & local dev — never uploaded to Vercel builds. .env/.env.* cover
# any dotenv file at any depth; race sessions are local runtime state;
# tests stay git-tracked but ship nowhere; biwa-dev.sh and the dev runner
# are local-only — Vercel loads the api/*.py route modules, never the
# launcher harness.
.env
.env.*
**/.env
**/.env.*
.race_sessions.json
**/.race_sessions.json
biwa-dev.sh
tests/
lib/biwa/biwa-dev.py
# Old build/link metadata preserved on disk — never uploaded.
.vercel.bak/

# Editor configs
.vscode/
.idea/
*.swp
*.swo
*~
.windsurfrules

# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backups
*.bak
*.backup
*-ori.html
*-old.*

# Test files
test.js
*-test.js
*-testdata.js

# Git
.git/
.gitignore

# Build artifacts
tsconfig.tsbuildinfo
*.tsbuildinfo

# Development scripts
start-dev.sh
proxy-server.js

# Vercel
.vercel/

# Keep these in git for local `uv` workflows, but do not upload them.
# CLI 59 sees pyproject.toml + fastapi and builds one FastAPI app that
# bundles resources/ + public/ (~240MB) into the function zip.
pyproject.toml
uv.lock

